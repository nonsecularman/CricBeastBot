[Unit]
Description=CricBeastBot - Telegram cricket game bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cricbeast
WorkingDirectory=/opt/CricBeastBot
EnvironmentFile=/opt/CricBeastBot/.env
ExecStart=/opt/CricBeastBot/venv/bin/python /opt/CricBeastBot/main.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/cricbeastbot/bot.log
StandardError=append:/var/log/cricbeastbot/bot.error.log

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
