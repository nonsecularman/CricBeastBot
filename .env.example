# ===== CricBeastBot Configuration =====

# Telegram bot token from @BotFather (REQUIRED)
BOT_TOKEN=

# Telegram numeric user ID of the bot owner (REQUIRED)
# This user gets access to /owner and /cheat panels.
BOT_OWNER_ID=

# Database connection string.
# SQLite (default, good for local dev):
DATABASE_URL=sqlite+aiosqlite:///./cricbeast.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cricbeast

# Private channel/group ID used for the secret live game log.
# The bot MUST be an admin member of this channel.
LOG_CHANNEL_ID=

# ===== Optional media configuration (cricket animations) =====
# Leave blank to disable a particular animation category.
MEDIA_BOWLING=https://files.catbox.moe/d99hdp.MP4
MEDIA_BATTING=https://files.catbox.moe/b6p2lc.MP4
MEDIA_OUT=https://files.catbox.moe/qja6dq.MP4
MEDIA_FOUR=https://files.catbox.moe/b6p2lc.MP4
MEDIA_SIX=https://files.catbox.moe/d99hdp.MP4

# ===== Gameplay tuning (optional, sensible defaults used if blank) =====
# Minimum players required to auto-start a solo queue
SOLO_MIN_PLAYERS=2
# Maximum players allowed in a solo queue
SOLO_MAX_PLAYERS=8
# Global per-user command/callback rate limit (actions per RATE_LIMIT_WINDOW seconds)
RATE_LIMIT_ACTIONS=8
RATE_LIMIT_WINDOW=5
